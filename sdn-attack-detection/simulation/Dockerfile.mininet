# Dockerfile.mininet — Mininet + OVS container (no Ryu needed)
#
# Usa OVS in modalità standalone (self-learning L2 switch).
# Le statistiche vengono lette direttamente via ovs-ofctl e inviate al Flask controller.
#
# Esecuzione via docker-compose:
#   docker compose -f app_sdn/docker-compose.yml up --build

FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    mininet \
    openvswitch-switch \
    python3 python3-pip \
    hping3 iperf3 nmap \
    net-tools iproute2 iputils-ping \
    tcpdump curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir requests

WORKDIR /app
COPY simulation  /app/simulation

ENV CONTROLLER_URL=http://controller:9000
ENV NORMAL_PHASE=30
ENV ATTACK_PHASE=30

CMD ["bash", "-c", \
     "service openvswitch-switch start; \
      ovs-vswitchd --detach --pidfile \
        --log-file=/var/log/openvswitch/ovs-vswitchd.log || true; \
      sleep 2 && python3 -u simulation/mininet_live.py"]

# Dockerfile.mininet — Mininet + OVS + Ryu container
#
# Τρέχει privileged (απαιτείται για Mininet network namespaces + OVS).
# Περιέχει:
#   - Mininet (apt)
#   - Open vSwitch (apt)
#   - os-ken (pip) — maintained fork του Ryu, Python 3.10+ compatible
#   - hping3, iperf3 — για traffic generation / attack simulation
#
# Εκτέλεση μέσω docker-compose (βλ. app_sdn/docker-compose.yml):
#   docker compose -f app_sdn/docker-compose.yml up --build

FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    mininet \
    openvswitch-switch \
    openvswitch-testcontroller \
    python3 python3-pip \
    hping3 iperf3 nmap \
    net-tools iproute2 iputils-ping \
    tcpdump curl \
    && rm -rf /var/lib/apt/lists/*

# ryu 4.34 install + patches για Python 3.10 compatibility
RUN pip3 install --no-cache-dir ryu requests flask && \
    python3 -c "
import glob

# Patch 1: eventlet >= 0.36 αφαίρεσε ALREADY_HANDLED από wsgi
wsgi = '/usr/local/lib/python3.10/dist-packages/ryu/app/wsgi.py'
t = open(wsgi).read()
t = t.replace(
    'from eventlet.wsgi import ALREADY_HANDLED',
    'try:\n    from eventlet.wsgi import ALREADY_HANDLED\nexcept ImportError:\n    ALREADY_HANDLED = b\"\"'
)
open(wsgi, 'w').write(t)

# Patch 2: Python 3.10 αφαίρεσε collections.X (χρησιμοποίησε collections.abc.X)
abc_names = ['Callable','Mapping','MutableMapping','MutableSequence',
             'Sequence','Iterable','Iterator','MutableSet']
patched = 0
for f in glob.glob('/usr/local/lib/python3.10/dist-packages/ryu/**/*.py', recursive=True):
    try:
        t = open(f).read()
        nt = t
        for name in abc_names:
            nt = nt.replace('collections.' + name, 'collections.abc.' + name)
        nt = nt.replace('collections.abc.abc.', 'collections.abc.')
        if nt != t:
            open(f, 'w').write(nt)
            patched += 1
    except Exception:
        pass
print(f'ryu patched: 1 wsgi + {patched} collections files')
"

WORKDIR /app

# κώδικας που χρειάζεται το Mininet container
COPY simulation  /app/simulation
COPY controller  /app/controller
COPY models      /app/models
COPY ml_pipeline /app/ml_pipeline

ENV CONTROLLER_URL=http://controller:9000
ENV RYU_PORT=6653
ENV NORMAL_PHASE=30
ENV ATTACK_PHASE=30

# Εκκίνηση: OVS → mininet_live.py (που ξεκινά και τον Ryu bridge εσωτερικά)
CMD ["bash", "-c", \
     "service openvswitch-switch start && sleep 2 && \
      python3 simulation/mininet_live.py"]
